{
  "compilerOptions": {
    "target": "es2015",
    "module": "es2022",
    "types": [
      "jest", "node"
    ],
    "lib": ["es6", "dom"],
    "allowJs": false,
    "declaration": true,
    "removeComments": false,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src/**/*"
  ]
}
